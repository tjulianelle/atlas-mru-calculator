# Atlas MRU v2 Calculator - environment variables
# Copy this file to .env for local development. In Railway, set these as
# environment variables in the service settings.

# Required: password to access the calculator
ATLAS_PASSWORD=changeme

# Optional: username (defaults to "atlas")
ATLAS_USERNAME=atlas

# Optional: port (Railway sets this automatically; defaults to 3000 locally)
PORT=3000
